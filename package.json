{
  "name": "personal-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --project default",
    "test:structural": "vitest run --project structural",
    "test:all": "vitest run",
    "lens:regen": "LENS_STORY_MAP=1 LENS_STORY_COST=1 LENS_PIECE_FLOW=1 vitest run src/lib/lens/story/__tests__/story-map.test.ts src/lib/lens/story/__tests__/story-cost.test.ts src/lib/lens/story/__tests__/piece-flow.test.ts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "astro-icon": "^1.1.5",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@iconify-json/lucide": "^1.2.116",
    "@tailwindcss/typography": "^0.5.20",
    "@types/three": "^0.185.1",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
