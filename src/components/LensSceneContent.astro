---
/**
 * Arbitrary overlay content for one scroll-story scene (the lens hero).
 *
 *   <LensSceneContent scene="zoom" pos="left">
 *     ...anything — headings, charts, images, custom components...
 *   </LensSceneContent>
 *
 * Placed by LAYOUT, not by the scroll driver: it renders inside a BAND — its
 * scene's slice of the scroll track, sized from CAPTION_BANDS in
 * story/story.ts — and is `position: sticky` within it, so it slides in, pins
 * and leaves because of where it sits in the document, whether or not the 3D
 * scene ever boots. A `scene` no story scene owns is a BUILD ERROR.
 *
 * `pos` places the block where the parked lens isn't and picks the sticky slot.
 * Placement/responsive CSS lives HERE; the slotted content's typography is the
 * caller's, and the fade is LensStory.astro's (one system for every band).
 *
 * The scroll driver, when there is one, writes `--beat-local`,
 * `--beat-progress` (smoothstepped over the progressFrom/To window) and
 * `--beat-visibility` onto the wrapper each frame. They are pure enhancement —
 * nothing about the block's visibility depends on them.
 */
import { bandOf } from "../lib/lens";

interface Props {
  /** StoryScene id from story/story.ts (e.g. "zoom", "internals") — the band. */
  scene: string;
  /** Which stage edge to occupy on desktop. Default "left". */
  pos?: "left" | "right" | "top" | "bottom";
  /** Scene-local window (0..1) over which `--beat-progress` sweeps 0→1. */
  progressFrom?: number;
  progressTo?: number;
  class?: string;
}
const {
  scene,
  pos = "left",
  progressFrom = 0,
  progressTo = 1,
  class: className,
} = Astro.props;
const band = bandOf(scene);
---

<div
  class="cap-band"
  data-band={scene}
  data-final={band.finalAttr}
  data-pos={pos}
  style={`top:${band.top};height:${band.height}`}
>
  <div
    class:list={["lens-cap", className]}
    data-cap-fade
    data-beat={scene}
    data-pos={pos}
    data-progress-from={progressFrom}
    data-progress-to={progressTo}
  >
    <slot />
  </div>
</div>

<style>
  /* The band is a COLUMN so a bottom-slot caption can sit at its END: a sticky
     `bottom` offset only ever shifts a box UP, so a caption left at the band's
     top would scroll through the slot instead of pinning in it.

     SLOT LAW — every slot below must satisfy `slot offset + caption height ≤
     100svh`, which is exactly the condition for the caption to be dark for the
     whole of its travel at every viewport. Offsets are svh, matching the bands
     they stick inside. */
  .cap-band {
    display: flex;
    flex-direction: column;
  }
  .cap-band[data-pos="bottom"] {
    justify-content: flex-end;
  }

  .lens-cap {
    position: sticky;
    display: flex;
    flex-direction: column;
    /* shrink-to-fit: a sticky caption is IN FLOW, so left to `auto` it would
       fill its band to the max-width and re-wrap narrower copy. */
    width: fit-content;
    max-width: 400px;
    will-change: opacity;
  }

  /* PINNED SLOTS — the story table's per-scene cam.xs framing is tuned against
     these positions. The sticky offset IS the pinned position; horizontal
     placement is a margin off the band's column edge, since `left`/`right`
     would be sticky offsets here rather than placement. */
  .lens-cap[data-pos="left"] {
    top: 50svh;
    transform: translateY(-50%);
    margin-left: 1.5rem;
    margin-right: auto;
    text-align: left;
    align-items: flex-start;
  }
  .lens-cap[data-pos="right"] {
    top: 50svh;
    transform: translateY(-50%);
    margin-left: auto;
    margin-right: 1.5rem;
    text-align: right;
    align-items: flex-end;
  }
  @media (min-width: 1024px) {
    .lens-cap[data-pos="left"] {
      margin-left: 2rem;
    }
    .lens-cap[data-pos="right"] {
      margin-right: 2rem;
    }
  }
  .lens-cap[data-pos="top"] {
    top: 11svh;
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 620px;
  }
  .lens-cap[data-pos="bottom"] {
    bottom: 12svh;
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 560px;
  }
  /* the big ghost numerals only work at the stage edges */
  .lens-cap[data-pos="top"] :global(.cap-ghost),
  .lens-cap[data-pos="bottom"] :global(.cap-ghost) {
    display: none;
  }
  /* scrim behind blocks that sit over the lens so text wins against the
     wireframe. --scrim-rgb is set per THEME by the page and inherits here. */
  .lens-cap[data-pos="top"]::before,
  .lens-cap[data-pos="bottom"]::before {
    content: "";
    position: absolute;
    inset: -46px -110px;
    z-index: -1;
    background: radial-gradient(
      ellipse 66% 100% at 50% 50%,
      rgb(var(--scrim-rgb, 18 16 11) / 0.86),
      rgb(var(--scrim-rgb, 18 16 11) / 0) 72%
    );
  }
  /* right-placed blocks: dramatic rag-right heading, but body copy reads left */
  .lens-cap[data-pos="right"] :global(.cap-body) {
    text-align: left;
  }

  /* ---- mobile / portrait: every block collapses into a scrimmed BOTTOM band
         (pos="top" keeps a top band), never floating over the lens. Keyed to
         where the lens park is OFF: parkScaleFor (core/scene.ts) is 0 at
         aspect ≤ 4/5, so a portrait tablet takes this layout too. */
  @media (max-width: 760px), (max-aspect-ratio: 4/5) {
    .cap-band,
    .cap-band[data-pos] {
      /* every block shares the ONE bottom slot, so consecutive captions hand
         over IN PLACE — a cross-dissolve, not one sliding past the other. */
      justify-content: flex-end;
    }
    .cap-band[data-pos="top"] {
      justify-content: flex-start;
    }
    /* [data-pos] keeps specificity level with the desktop placement rules so
       source order wins; a bare .lens-cap would lose text-align to them */
    .lens-cap,
    .lens-cap[data-pos] {
      top: auto !important;
      bottom: 11svh;
      transform: none !important;
      margin-inline: auto !important;
      text-align: center;
      align-items: center;
      max-width: min(88vw, 460px);
    }
    .lens-cap[data-pos="top"] {
      top: 12svh !important;
      bottom: auto;
    }
    /* the desktop-only ghost numerals eat half the band on a phone */
    .lens-cap :global(.cap-ghost) {
      display: none;
    }
    /* scrim behind EVERY mobile block (theme-tinted, same var as above) */
    .lens-cap::before {
      content: "";
      position: absolute;
      inset: -36px -70px;
      z-index: -1;
      background: radial-gradient(
        ellipse 70% 100% at 50% 50%,
        rgb(var(--scrim-rgb, 18 16 11) / 0.85),
        rgb(var(--scrim-rgb, 18 16 11) / 0) 74%
      );
    }
    .lens-cap :global(.cap-body) {
      text-align: center;
    }
  }
  /* a small LANDSCAPE window still parks the lens aside (parkScaleFor > 0
     above aspect 4/5): half the band keeps the caption off it */
  @media (max-width: 760px) and (min-aspect-ratio: 4/5) {
    .lens-cap,
    .lens-cap[data-pos] {
      max-width: 50%;
    }
  }
</style>
