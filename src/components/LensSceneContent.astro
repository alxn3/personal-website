---
/**
 * Caption content for one lens-hero scene:
 *
 *   <LensSceneContent scene="zoom" pos="left">…any markup…</LensSceneContent>
 *
 * Renders the scene's band (its slice of the scroll track) with the content
 * sticky inside, so it works without JS. An unknown `scene` fails the build.
 * Placement lives here, typography with the caller, fades in LensStory.astro.
 */
import { bandOf } from "../lib/lens";

interface Props {
  /** Story scene id from story/story.ts, e.g. "zoom". */
  scene: string;
  /** Stage edge to occupy on desktop. */
  pos?: "left" | "right" | "top" | "bottom";
}
const { scene, pos = "left" } = Astro.props;
const band = bandOf(scene);
---

<div
  class="cap-band"
  data-band={scene}
  data-final={band.finalAttr}
  data-pos={pos}
  style={`top:${band.top};height:${band.height}`}
>
  <div class="lens-cap" data-cap-fade data-beat={scene} data-pos={pos}>
    <slot />
  </div>
</div>

<style>
  /* A column, so a bottom-slot caption can sit at the band's end (a sticky
     `bottom` offset only moves a box up). Every slot must keep
     offset + caption height ≤ 100svh, or the caption shows while travelling. */
  .cap-band {
    display: flex;
    flex-direction: column;
  }
  .cap-band[data-pos="bottom"] {
    justify-content: flex-end;
  }

  .lens-cap {
    position: sticky;
    display: flex;
    flex-direction: column;
    /* shrink to fit; in-flow sticky boxes would otherwise fill the band */
    width: fit-content;
    max-width: 400px;
    will-change: opacity;
  }

  /* Pinned slots; the story table's cam.xs framing is tuned to them. The
     sticky offset is the position; horizontal placement uses margins, since
     left/right would act as sticky offsets. */
  .lens-cap[data-pos="left"] {
    top: 50svh;
    transform: translateY(-50%);
    margin-left: 1.5rem;
    margin-right: auto;
    text-align: left;
    align-items: flex-start;
  }
  .lens-cap[data-pos="right"] {
    top: 50svh;
    transform: translateY(-50%);
    margin-left: auto;
    margin-right: 1.5rem;
    text-align: right;
    align-items: flex-end;
  }
  @media (min-width: 1024px) {
    .lens-cap[data-pos="left"] {
      margin-left: 2rem;
    }
    .lens-cap[data-pos="right"] {
      margin-right: 2rem;
    }
  }
  .lens-cap[data-pos="top"] {
    top: 11svh;
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 620px;
  }
  .lens-cap[data-pos="bottom"] {
    bottom: 12svh;
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 560px;
  }
  /* ghost numerals only at the stage edges */
  .lens-cap[data-pos="top"] :global(.cap-ghost),
  .lens-cap[data-pos="bottom"] :global(.cap-ghost) {
    display: none;
  }
  /* scrim behind blocks that sit over the lens; --scrim-rgb comes from the
     stage theme */
  .lens-cap[data-pos="top"]::before,
  .lens-cap[data-pos="bottom"]::before {
    content: "";
    position: absolute;
    inset: -46px -110px;
    z-index: -1;
    background: radial-gradient(
      ellipse 66% 100% at 50% 50%,
      rgb(var(--scrim-rgb, 18 16 11) / 0.86),
      rgb(var(--scrim-rgb, 18 16 11) / 0) 72%
    );
  }
  /* right-placed blocks: right-aligned heading, left-aligned body */
  .lens-cap[data-pos="right"] :global(.cap-body) {
    text-align: left;
  }

  /* Phones and portrait (where parkScaleFor is 0): every block moves to one
     scrimmed bottom slot (pos="top" keeps a top slot). */
  @media (max-width: 760px), (max-aspect-ratio: 4/5) {
    .cap-band,
    .cap-band[data-pos] {
      justify-content: flex-end;
    }
    .cap-band[data-pos="top"] {
      justify-content: flex-start;
    }
    /* [data-pos] matches the desktop rules' specificity so source order wins */
    .lens-cap,
    .lens-cap[data-pos] {
      top: auto !important;
      bottom: 11svh;
      transform: none !important;
      margin-inline: auto !important;
      text-align: center;
      align-items: center;
      max-width: min(88vw, 460px);
    }
    .lens-cap[data-pos="top"] {
      top: 12svh !important;
      bottom: auto;
    }
    .lens-cap :global(.cap-ghost) {
      display: none;
    }
    /* scrim behind every mobile block */
    .lens-cap::before {
      content: "";
      position: absolute;
      inset: -36px -70px;
      z-index: -1;
      background: radial-gradient(
        ellipse 70% 100% at 50% 50%,
        rgb(var(--scrim-rgb, 18 16 11) / 0.85),
        rgb(var(--scrim-rgb, 18 16 11) / 0) 74%
      );
    }
    .lens-cap :global(.cap-body) {
      text-align: center;
    }
  }
  /* small landscape windows still park the lens aside: use half the band */
  @media (max-width: 760px) and (min-aspect-ratio: 4/5) {
    .lens-cap,
    .lens-cap[data-pos] {
      max-width: 50%;
    }
  }
</style>
