---
/**
 * Arbitrary overlay content for one scroll-story scene (the lens hero).
 *
 * Drop ANY markup/components inside. The block is placed by LAYOUT, not by the
 * scroll driver: it renders inside a BAND — its scene's slice of the scroll
 * track, sized from CAPTION_BANDS (lib/lens/story/story.ts) — and is
 * `position: sticky` within it, so it slides in, pins in its slot and leaves
 * because of where it sits in the document. It shows on scroll whether or not
 * the 3D scene ever boots.
 *
 *   <LensSceneContent scene="zoom" pos="left">
 *     ...anything — headings, charts, images, custom components...
 *   </LensSceneContent>
 *
 * `pos` places the block where the parked lens isn't, and picks the sticky slot
 * it pins into. On phones every block collapses to a scrimmed BOTTOM band
 * (`pos="top"` keeps a top band) so content never floats mid-screen over the
 * wireframe. Placement/responsive CSS lives HERE (scoped to the wrapper);
 * typography of the slotted content is the caller's business, and the fade
 * itself is LensStory.astro's (one system for every band).
 *
 * A `scene` no story scene owns is a BUILD ERROR — bandOf throws below.
 *
 * The scroll driver, when there is one, writes progress custom properties onto
 * the wrapper each frame for content-specific CSS effects: `--beat-local` (raw
 * scene-local progress 0..1), `--beat-progress` — a smoothstepped 0→1 sweep over
 * the `progressFrom`/`progressTo` window (in scene-local 0..1; defaults 0 and 1,
 * i.e. the whole scene) — and `--beat-visibility`, the story table's own fade
 * band for the block (what the CSS fade approximates; the pins ride it). They
 * are pure enhancement: nothing about the block's visibility depends on them.
 */
import { bandOf } from "../lib/lens";

interface Props {
  /** StoryScene id from story/story.ts (e.g. "zoom", "internals") — the band. */
  scene: string;
  /** Which stage edge to occupy on desktop. Default "left". */
  pos?: "left" | "right" | "top" | "bottom";
  /** Scene-local window (0..1) over which `--beat-progress` sweeps 0→1. */
  progressFrom?: number;
  progressTo?: number;
  class?: string;
}
const {
  scene,
  pos = "left",
  progressFrom = 0,
  progressTo = 1,
  class: className,
} = Astro.props;
const band = bandOf(scene);
---

<div
  class="cap-band"
  data-band={scene}
  data-final={band.finalAttr}
  data-pos={pos}
  style={`top:${band.top};height:${band.height}`}
>
  <div
    class:list={["lens-cap", className]}
    data-cap-fade
    data-beat={scene}
    data-pos={pos}
    data-progress-from={progressFrom}
    data-progress-to={progressTo}
  >
    <slot />
  </div>
</div>

<style>
  /* The band is a COLUMN so a bottom-slot caption can sit at its END: a sticky
     `bottom` offset only ever shifts a box UP, and never past its containing
     block, so a caption left at the band's top could not move at all — it would
     scroll through the slot instead of pinning in it.

     SLOT LAW (spec §6 — fade covers travel). LensStory.astro fades a caption in
     over the viewport AFTER its band's top edge reaches the viewport top, and
     out over the viewport BEFORE its band's bottom edge reaches the viewport
     bottom. So every slot below only has to satisfy one inequality to be dark
     for the whole of its travel, at every viewport, with no per-slot tuning:

         slot offset + caption height ≤ 100dvh

     A `top: T` caption rides its band's top edge for the first (100dvh − T) of
     travel and unpins (T + h) before the band's view range ends; a `bottom: X`
     one parks after (X + h) and unpins (100dvh − X) before the end — both
     within the windows exactly when the inequality holds. Worst case here is a
     desktop left/right block: 50dvh + h, so a caption taller than half the
     viewport would start lighting up mid-travel. */
  .cap-band {
    display: flex;
    flex-direction: column;
  }
  .cap-band[data-pos="bottom"] {
    justify-content: flex-end;
  }

  .lens-cap {
    position: sticky;
    display: flex;
    flex-direction: column;
    /* shrink-to-fit, exactly as the absolutely-positioned block used to be —
       the pinned slots below reproduce that box. A sticky caption is IN FLOW,
       so left to `auto` it would fill its band up to the max-width and re-wrap
       the copy of anything narrower than its cap. */
    width: fit-content;
    max-width: 400px;
    will-change: opacity;
  }

  /* PINNED SLOTS — the on-screen positions these blocks held inside the pinned
     stage, reproduced exactly: that is what the story table's per-scene cam.xs
     framing was tuned against. The sticky offset IS the pinned position; the
     horizontal placement is a margin off the band's column edge (the band is
     the old .cap-frame column, so 1.5rem/2rem land where they always did —
     `left`/`right` would be sticky offsets here, not placement). */
  .lens-cap[data-pos="left"] {
    top: 50dvh;
    transform: translateY(-50%);
    margin-left: 1.5rem;
    margin-right: auto;
    text-align: left;
    align-items: flex-start;
  }
  .lens-cap[data-pos="right"] {
    top: 50dvh;
    transform: translateY(-50%);
    margin-left: auto;
    margin-right: 1.5rem;
    text-align: right;
    align-items: flex-end;
  }
  @media (min-width: 1024px) {
    .lens-cap[data-pos="left"] {
      margin-left: 2rem;
    }
    .lens-cap[data-pos="right"] {
      margin-right: 2rem;
    }
  }
  .lens-cap[data-pos="top"] {
    top: 11dvh;
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 620px;
  }
  .lens-cap[data-pos="bottom"] {
    bottom: 12dvh;
    margin-inline: auto;
    text-align: center;
    align-items: center;
    max-width: 560px;
  }
  /* the big ghost numerals only work at the stage edges */
  .lens-cap[data-pos="top"] :global(.cap-ghost),
  .lens-cap[data-pos="bottom"] :global(.cap-ghost) {
    display: none;
  }
  /* scrim behind blocks that sit over the lens (top/bottom centre) so text
     always wins against the wireframe. --scrim-rgb is set per THEME by the page
     (#lens-hero) — dark stage vs warm paper — and inherits down to here. */
  .lens-cap[data-pos="top"]::before,
  .lens-cap[data-pos="bottom"]::before {
    content: "";
    position: absolute;
    inset: -46px -110px;
    z-index: -1;
    background: radial-gradient(
      ellipse 66% 100% at 50% 50%,
      rgb(var(--scrim-rgb, 18 16 11) / 0.86),
      rgb(var(--scrim-rgb, 18 16 11) / 0) 72%
    );
  }
  /* right-placed blocks: dramatic rag-right heading, but body copy reads left */
  .lens-cap[data-pos="right"] :global(.cap-body) {
    text-align: left;
  }

  /* ---- mobile / portrait: every block collapses into a scrimmed BOTTOM band
         (pos="top" keeps a top band) — never floating mid-screen over the lens.
         The slot is the same one, expressed as a sticky bottom offset. */
  @media (max-width: 760px) {
    .cap-band,
    .cap-band[data-pos] {
      /* every block shares the ONE bottom slot here, so consecutive captions
         hand over IN PLACE — a cross-dissolve rather than one sliding out past
         the other. The windows are the same as everywhere else: the slot law
         above holds with room to spare (11dvh + a phone caption's ≤250px). */
      justify-content: flex-end;
    }
    .cap-band[data-pos="top"] {
      justify-content: flex-start;
    }
    /* [data-pos] keeps specificity level with the desktop placement rules, so
       source order (this block is later) wins — a bare .lens-cap would lose
       text-align to .lens-cap[data-pos="right"] and leave ragged-right titles */
    .lens-cap,
    .lens-cap[data-pos] {
      top: auto !important;
      bottom: 11dvh;
      transform: none !important;
      margin-inline: auto !important;
      text-align: center;
      align-items: center;
      /* the 50% term reproduces the width these captions had before the bands
         existed (an abspos box at left: 50%, so shrink-to-fit got half the
         column) — the framing in the story table's cam.xs was tuned against it */
      max-width: min(88vw, 460px, 50%);
    }
    .lens-cap[data-pos="top"] {
      top: 12dvh !important;
      bottom: auto;
    }
    /* the desktop-only ghost numerals eat half the band on a phone */
    .lens-cap :global(.cap-ghost) {
      display: none;
    }
    /* scrim behind EVERY mobile block (theme-tinted, same var as above) */
    .lens-cap::before {
      content: "";
      position: absolute;
      inset: -36px -70px;
      z-index: -1;
      background: radial-gradient(
        ellipse 70% 100% at 50% 50%,
        rgb(var(--scrim-rgb, 18 16 11) / 0.85),
        rgb(var(--scrim-rgb, 18 16 11) / 0) 74%
      );
    }
    .lens-cap :global(.cap-body) {
      text-align: center;
    }
  }
</style>
