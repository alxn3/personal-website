---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Selector for a full-bleed backdrop the page parks UNDER the bar (the
   *  homepage story stage). While it still covers the bar, the bar drops its
   *  border and blur so the backdrop runs unbroken to the top of the window;
   *  once the page has scrolled past it, ordinary content would slide under the
   *  nav labels, so the chrome comes back. */
  clearOver?: string;
}

const { clearOver } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header
  class="border-border fixed inset-x-0 top-0 z-50 border-b backdrop-blur transition-[border-color,backdrop-filter] data-clear:border-transparent data-clear:backdrop-blur-none"
  data-clear-over={clearOver}
  data-clear={clearOver ? "" : undefined}
  x-data="{ open: false }"
>
  <nav
    class="max-w-layout mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Primary navigation"
  >
    <a
      href="/"
      class="text-text focus-visible:ring-accent focus-visible:ring-offset-bg rounded-md font-serif text-xl font-bold focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Alex Lin
    </a>

    <div class="flex items-center">
      <div class="hidden items-center gap-1.5 sm:flex" aria-label="Main pages">
        {
          navItems.map((item) => {
            const isCurrent = isCurrentPath(item.href);

            return (
              <a
                href={item.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  // the ring rides a --bg ring-offset cushion — the halo device
                  // extended to focus: readable over the clear bar's arbitrary
                  // scene content (black barrel, bright cards) in both themes,
                  // where the UA default or a flat accent ring can vanish
                  "focus-visible:ring-accent focus-visible:ring-offset-bg rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none",
                  isCurrent
                    ? "text-highlight"
                    : "text-text-muted hover:text-text",
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>

      <ThemeToggle />

      <!-- the X starts x-cloak'd so only the hamburger paints before Alpine boots -->
      <button
        type="button"
        class="text-text-muted hover:text-accent focus-visible:ring-accent focus-visible:ring-offset-bg inline-flex size-9 items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none sm:hidden"
        x-on:click="open = !open"
        aria-expanded="false"
        x-bind:aria-expanded="open"
        aria-label="Toggle menu"
      >
        <Icon
          name="lucide:menu"
          class="size-5"
          x-show="!open"
          aria-hidden="true"
        />
        <Icon
          name="lucide:x"
          class="size-5"
          x-show="open"
          x-cloak
          aria-hidden="true"
        />
      </button>
    </div>
  </nav>

  <div
    class="border-border bg-bg absolute inset-x-0 top-full z-30 border-b shadow-sm sm:hidden"
    x-show="open"
    x-cloak
    x-on:click.outside="open = false"
    x-on:keydown.escape.window="open = false"
  >
    <div class="flex flex-col gap-1 px-4 py-3" aria-label="Main pages">
      {
        navItems.map((item) => {
          const isCurrent = isCurrentPath(item.href);

          return (
            <a
              href={item.href}
              aria-current={isCurrent ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isCurrent
                  ? "bg-accent-soft text-accent"
                  : "text-text-muted hover:bg-accent-soft hover:text-text",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>

<script>
  // `data-clear` is rendered by the server for a page that declares a backdrop,
  // so the chrome-less bar is the FIRST paint (no flash); this only takes it
  // away again once that backdrop has scrolled off the bar.
  const header = document.querySelector<HTMLElement>("header[data-clear-over]");
  const backdrop = header?.dataset.clearOver
    ? document.querySelector<HTMLElement>(header.dataset.clearOver)
    : null;

  if (header && backdrop) {
    // "the backdrop still covers the bar" IS the backdrop intersecting a
    // viewport clipped to the bar's own height, so the observer answers it
    // without measuring on the scroll. rootMargin is fixed at construction —
    // re-arm when the bar's height can have changed.
    let io: IntersectionObserver | null = null;
    const arm = () => {
      io?.disconnect();
      io = new IntersectionObserver(
        ([entry]) => header.toggleAttribute("data-clear", entry.isIntersecting),
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
      );
      io.observe(backdrop);
    };
    arm();
    addEventListener("resize", arm);
    // bfcache restores skip module re-eval; observing again re-syncs
    addEventListener("pageshow", arm);
  } else if (import.meta.env.DEV && header) {
    console.warn(
      `navbar: clearOver selector "${header.dataset.clearOver}" matched nothing — the bar will stay chrome-less everywhere`,
    );
  }
</script>

<style>
  /* THE CHROME-LESS BAR'S ONLY LEGIBILITY DEVICE. With no fill there is nothing
     between the bar's type and whatever the page scrolls under it, and the
     story's stage is not one colour: mid-dive the camera is inside the barrel,
     so a LIGHT-theme frame goes near-black under the nav for ~1.5 screenfuls,
     and in dark theme the cards scene sends bright photographs through the same
     band. The captions already answer this with a halo in the stage's own paper
     (LensStory's --cap-shadow); the bar takes the same device in the SITE's
     background — invisible over that background by definition, and only doing
     work where foreign content passes beneath. A halo, not a scrim: it hugs the
     letterforms, so the bar still has no edge of its own. */
  header[data-clear] nav {
    text-shadow:
      0 0 2px var(--bg),
      0 0 4px var(--bg),
      0 1px 14px var(--bg);
  }
  /* text-shadow does not reach the icons (the theme toggle, the mobile
     hamburger) — same halo, the one form that draws off a stroke. */
  header[data-clear] nav :global(svg) {
    filter: drop-shadow(0 0 4px var(--bg)) drop-shadow(0 1px 10px var(--bg));
  }
</style>
