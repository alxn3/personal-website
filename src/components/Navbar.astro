---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header class="border-border bg-bg border-b">
  <nav
    class="max-w-layout mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Primary navigation"
  >
    <a href="/" class="text-text font-serif text-xl font-bold">
      Personal Website
    </a>

    <div class="flex items-center gap-5">
      <div class="flex items-center gap-1.5" aria-label="Main pages">
        {
          navItems.map((item) => {
            const isCurrent = isCurrentPath(item.href);

            return (
              <a
                href={item.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
                  isCurrent
                    ? "bg-accent-soft text-accent"
                    : "text-text-muted hover:bg-accent-soft hover:text-text",
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>

      <ThemeToggle />
    </div>
  </nav>
</header>
