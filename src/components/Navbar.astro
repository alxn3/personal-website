---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  /** Selector for a full-bleed backdrop under the bar. While it covers the
   *  bar, the bar drops its border and blur. */
  clearOver?: string;
}

const { clearOver } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
].map((item) => ({
  ...item,
  current:
    item.href === "/"
      ? path === "/"
      : path === item.href || path.startsWith(`${item.href}/`),
}));
---

<header
  class="border-border fixed inset-x-0 top-0 z-50 border-b backdrop-blur transition-[border-color,backdrop-filter] data-clear:border-transparent data-clear:backdrop-blur-none"
  data-clear-over={clearOver}
  data-clear={clearOver ? "" : undefined}
  x-data="{ open: false }"
>
  <nav
    class="max-w-layout mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Primary navigation"
  >
    <a
      href="/"
      class="text-text focus-visible:ring-accent focus-visible:ring-offset-bg rounded-md font-serif text-xl font-bold focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Alex Lin
    </a>

    <div class="flex items-center">
      <div class="hidden items-center gap-1.5 sm:flex" aria-label="Main pages">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              aria-current={item.current ? "page" : undefined}
              class:list={[
                // the --bg ring offset keeps focus visible over any backdrop
                "focus-visible:ring-accent focus-visible:ring-offset-bg rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none",
                item.current
                  ? "text-highlight"
                  : "text-text-muted hover:text-text",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <ThemeToggle />

      <!-- the X starts x-cloak'd so only the hamburger paints before Alpine boots -->
      <button
        type="button"
        class="text-text-muted hover:text-accent focus-visible:ring-accent focus-visible:ring-offset-bg inline-flex size-9 items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none sm:hidden"
        x-on:click="open = !open"
        aria-expanded="false"
        x-bind:aria-expanded="open"
        aria-label="Toggle menu"
      >
        <Icon
          name="lucide:menu"
          class="size-5"
          x-show="!open"
          aria-hidden="true"
        />
        <Icon
          name="lucide:x"
          class="size-5"
          x-show="open"
          x-cloak
          aria-hidden="true"
        />
      </button>
    </div>
  </nav>

  <div
    class="border-border bg-bg absolute inset-x-0 top-full z-30 border-b shadow-sm sm:hidden"
    x-show="open"
    x-cloak
    x-on:click.outside="open = false"
    x-on:keydown.escape.window="open = false"
  >
    <div class="flex flex-col gap-1 px-4 py-3" aria-label="Main pages">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.current ? "page" : undefined}
            class:list={[
              "rounded-md px-3 py-2 text-sm font-medium transition-colors",
              item.current
                ? "bg-accent-soft text-accent"
                : "text-text-muted hover:bg-accent-soft hover:text-text",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  // The server renders `data-clear` when a backdrop is declared; this removes
  // it while the backdrop is not under the bar.
  const header = document.querySelector<HTMLElement>("header[data-clear-over]");
  const backdrop = header?.dataset.clearOver
    ? document.querySelector<HTMLElement>(header.dataset.clearOver)
    : null;

  if (header && backdrop) {
    // Observe the backdrop against a root clipped to the bar's height. The
    // margin is fixed at construction, so re-arm on resize.
    let io: IntersectionObserver | null = null;
    const arm = () => {
      io?.disconnect();
      io = new IntersectionObserver(
        ([entry]) => header.toggleAttribute("data-clear", entry.isIntersecting),
        { rootMargin: `-${header.offsetHeight}px 0px 0px 0px` },
      );
      io.observe(backdrop);
    };
    arm();
    addEventListener("resize", arm);
    // bfcache restores skip module re-eval; observing again re-syncs
    addEventListener("pageshow", arm);
  } else if (import.meta.env.DEV && header) {
    console.warn(
      `navbar: clearOver selector "${header.dataset.clearOver}" matched nothing — the bar will stay chrome-less everywhere`,
    );
  }
</script>

<style>
  /* The clear bar has no fill, so a --bg halo keeps its text readable over
     dark or bright backdrop frames. */
  header[data-clear] nav {
    text-shadow:
      0 0 2px var(--bg),
      0 0 4px var(--bg),
      0 1px 14px var(--bg);
  }
  /* the same halo for the icons, which text-shadow doesn't reach */
  header[data-clear] nav :global(svg) {
    filter: drop-shadow(0 0 4px var(--bg)) drop-shadow(0 1px 10px var(--bg));
  }
</style>
