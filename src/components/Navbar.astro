---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrentPath = (href: string) => {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header
  class="border-border fixed inset-x-0 top-0 z-50 border-b backdrop-blur transition-colors"
  x-data="{ open: false }"
>
  <nav
    class="max-w-layout mx-auto flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8"
    aria-label="Primary navigation"
  >
    <a href="/" class="text-text font-serif text-xl font-bold"> Alex Lin </a>

    <div class="flex items-center">
      <div class="hidden items-center gap-1.5 sm:flex" aria-label="Main pages">
        {
          navItems.map((item) => {
            const isCurrent = isCurrentPath(item.href);

            return (
              <a
                href={item.href}
                aria-current={isCurrent ? "page" : undefined}
                class:list={[
                  "rounded-md px-2.5 py-1.5 text-sm font-medium transition-colors",
                  isCurrent
                    ? "text-highlight"
                    : "text-text-muted hover:text-text",
                ]}
              >
                {item.label}
              </a>
            );
          })
        }
      </div>

      <ThemeToggle />

      <!-- Menu ↔ X swap is Alpine-driven; the X starts x-cloak'd so only the
           hamburger paints before Alpine boots. Hover matches the ThemeToggle. -->
      <button
        type="button"
        class="text-text-muted hover:text-accent inline-flex size-9 items-center justify-center rounded-md transition-colors sm:hidden"
        x-on:click="open = !open"
        x-bind:aria-expanded="open"
        aria-label="Toggle menu"
      >
        <Icon
          name="lucide:menu"
          class="size-5"
          x-show="!open"
          aria-hidden="true"
        />
        <Icon
          name="lucide:x"
          class="size-5"
          x-show="open"
          x-cloak
          aria-hidden="true"
        />
      </button>
    </div>
  </nav>

  <div
    class="border-border bg-bg absolute inset-x-0 top-full z-30 border-b shadow-sm sm:hidden"
    x-show="open"
    x-cloak
    x-on:click.outside="open = false"
    x-on:keydown.escape.window="open = false"
  >
    <div class="flex flex-col gap-1 px-4 py-3" aria-label="Main pages">
      {
        navItems.map((item) => {
          const isCurrent = isCurrentPath(item.href);

          return (
            <a
              href={item.href}
              aria-current={isCurrent ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isCurrent
                  ? "bg-accent-soft text-accent"
                  : "text-text-muted hover:bg-accent-soft hover:text-text",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </div>
  </div>
</header>
