---
// Start downloading the lens model during HTML parse. crossorigin="anonymous"
// must match three's fetch() or the file downloads twice.
// Only /lens uses the accessories model.
import { MODEL_URL, ACCESSORIES_URL } from "../lib/lens";

interface Props {
  accessories?: boolean;
}
const { accessories = false } = Astro.props;
---

<link rel="preload" href={MODEL_URL} as="fetch" crossorigin="anonymous" />
{
  accessories && (
    <link
      rel="preload"
      href={ACCESSORIES_URL}
      as="fetch"
      crossorigin="anonymous"
    />
  )
}
