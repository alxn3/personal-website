---
// Preload the lens model during HTML parse — these fetches otherwise wait for
// the module script to boot plus the WebGPU init. crossorigin="anonymous"
// matches three's own fetch() (mode cors, same-origin credentials); without it
// the preload would not match and the file downloads twice.
// The accessories GLB is /lens-only — the hero never shows one, so it neither
// preloads nor fetches it.
import { MODEL_URL, ACCESSORIES_URL } from "../lib/lens";

interface Props {
  accessories?: boolean;
}
const { accessories = false } = Astro.props;
---

<link rel="preload" href={MODEL_URL} as="fetch" crossorigin="anonymous" />
{
  accessories && (
    <link
      rel="preload"
      href={ACCESSORIES_URL}
      as="fetch"
      crossorigin="anonymous"
    />
  )
}
