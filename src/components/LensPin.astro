---
/**
 * A dot, leader line and label that follow one model node on screen:
 *
 *   <LensPin scene="internals" track="Focus_LeadScrew" label="STM lead screw" />
 *
 * The driver moves every [data-track] element each frame while its scene's band
 * shows, so pins must sit in a full-stage overlay. Track solid parts only:
 * shader-deformed shell pieces report their un-exploded position.
 */
interface Props {
  /** Story scene id whose band fades the pin. */
  scene: string;
  /** Model node name to follow, e.g. "Focus_LeadScrew", "Element_12". */
  track: string;
  label: string;
  /** Side of the dot the label sits on. */
  side?: "left" | "right";
}
const { scene, track, label, side = "right" } = Astro.props;
---

<div class="lens-pin" data-beat={scene} data-track={track} data-side={side}>
  <span class="pin-dot" aria-hidden="true"></span>
  <span class="pin-label">{label}</span>
</div>

<style>
  /* A zero-size point the driver moves onto the part via transform. */
  .lens-pin {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    /* hidden without a driver; the second factor waits for the camera to
       arrive (30% into the scene) before showing */
    opacity: calc(
      var(--beat-visibility, 0) * clamp(0, (var(--beat-local, 0) - 0.3) * 6, 1)
    );
    pointer-events: none;
    will-change: opacity, transform;
  }
  .pin-dot {
    position: absolute;
    left: 0;
    top: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--orange, #d18a5d);
    box-shadow: 0 0 0 3px rgba(209, 138, 93, 0.22);
    transform: translate(-50%, -50%);
  }
  .pin-label {
    position: absolute;
    top: 0;
    left: 30px;
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink, #ece7da);
    text-shadow: var(--cap-shadow-sm, 0 1px 10px rgba(0, 0, 0, 0.8));
  }
  /* leader line from the dot out to the label */
  .pin-label::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -24px;
    width: 20px;
    height: 1px;
    background: rgba(209, 138, 93, 0.55);
  }
  /* mirrored: label on the LEFT of the dot */
  .lens-pin[data-side="left"] .pin-label {
    left: auto;
    right: 30px;
    text-align: right;
  }
  .lens-pin[data-side="left"] .pin-label::before {
    left: auto;
    right: -24px;
  }

  /* Phones: labels would run off screen. The driver skips display:none pins. */
  @media (max-width: 760px) {
    .lens-pin {
      display: none;
    }
  }
</style>
