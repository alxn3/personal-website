---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  aria-label="Toggle color theme"
  title="Toggle color theme"
  class="border-border bg-surface text-text hover:bg-accent-soft focus-visible:ring-accent focus-visible:ring-offset-surface inline-flex h-9 w-9 items-center justify-center rounded-md border transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
  x-data
  x-on:click="
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  "
>
  <!-- Sun: shown in light mode. Moon: shown in dark mode.
       Visibility is driven by the .dark class via CSS, so the
       right icon paints immediately with no flash. -->
  <Icon name="lucide:sun" class="size-4 dark:hidden" aria-hidden="true" />
  <Icon name="lucide:moon" class="hidden size-4 dark:block" aria-hidden="true" />
</button>
