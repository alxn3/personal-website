---
import { Icon } from "astro-icon/components";
---

<button
  type="button"
  aria-label="Toggle color theme"
  title="Toggle color theme"
  class="text-text-muted hover:text-accent focus-visible:ring-accent inline-flex h-9 w-9 items-center justify-center rounded-md transition-colors focus-visible:ring-2 focus-visible:outline-none"
  x-data
  x-on:click="$store.theme.toggle()"
>
  <!-- icon visibility is driven by the .dark class via CSS, so the
       right icon paints immediately with no flash -->
  <Icon name="lucide:sun" class="size-4 dark:hidden" aria-hidden="true" />
  <Icon
    name="lucide:moon"
    class="hidden size-4 dark:block"
    aria-hidden="true"
  />
</button>
