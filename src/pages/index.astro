---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Personal Website" description="Personal website">
  <section class="py-20 sm:py-28">
    <div>
      <p class="text-accent text-sm font-semibold tracking-wide uppercase">
        Personal Website
      </p>
      <h1
        class="text-text mt-4 max-w-3xl text-5xl leading-tight font-black text-balance sm:text-6xl"
      >
        Building thoughtful software with clear systems and practical details.
      </h1>
      <p class="text-text-muted mt-6 max-w-2xl text-lg leading-8">
        I write about engineering, design durable web interfaces, and collect
        projects that make day-to-day work a little sharper.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/projects"
          class="bg-accent text-bg hover:bg-text focus-visible:ring-accent inline-flex h-10 items-center rounded-md px-4 text-sm font-semibold transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          View projects
        </a>
        <a
          href="/blog"
          class="border-border text-text hover:bg-accent-soft focus-visible:ring-accent inline-flex h-10 items-center rounded-md border px-4 text-sm font-semibold transition-colors focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
        >
          Read blog
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
