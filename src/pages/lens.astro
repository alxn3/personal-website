---
import { loadAnimations } from "../lib/lens";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import HtmlShell from "../layouts/HtmlShell.astro";
import LensPreloads from "../components/LensPreloads.astro";

// Server-side load for the markup; the client loads its own copy in boot().
const { ANIMATIONS, fmtParam } = await loadAnimations();

const tabs = [
  { id: "controls", label: "Controls" },
  { id: "animations", label: "Animations" },
];

// Slider ids are SceneState channel names: `slider-zoom` drives `zoomTarget`.
const sliders = [
  { id: "zoom", label: "Zoom", hint: "18mm — 50mm" },
  { id: "focus", label: "Focus", hint: "∞ — 0.12m" },
  { id: "aperture", label: "Aperture", hint: "f/2.8 — f/22" },
  { id: "explode", label: "Exploded view", hint: "assembled — parts" },
];

const accessories = [
  { id: "hood", label: "Hood" },
  { id: "filter", label: "UV filter" },
  { id: "caps", label: "Caps" },
];

const shadingModes = [
  { id: "realistic", label: "Realistic" },
  { id: "ink", label: "Ink" },
  { id: "blueprint", label: "Blueprint" },
  { id: "flat", label: "Flat" },
  { id: "outline", label: "Outline" },
  { id: "ember", label: "Ember" },
  { id: "paper", label: "Paper" },
  { id: "riso", label: "Riso" },
  { id: "bronze", label: "Bronze" },
];

// Shading-swap transitions; ids match TransitionName.
const shadingTransitions = [
  { id: "blink", label: "Blink" },
  { id: "twist", label: "Twist" },
  { id: "molt", label: "Molt" },
  { id: "punch", label: "Punch" },
];

// Toggles under the animation list; the paths and inspect modules load when
// first ticked.
const tools = [
  { id: "paths", label: "Motion paths", note: "" },
  {
    id: "inspect",
    label: "Inspect",
    note: "Hover a piece for its node name; click to copy it.",
  },
  {
    id: "storycam",
    label: "Hero camera",
    note: "Progress plays the homepage's rewrap → bloom camera move (select an animation first).",
  },
];

const PILL =
  "border-border text-text-muted hover:text-text aria-pressed:bg-accent aria-pressed:border-accent aria-pressed:text-bg cursor-pointer rounded-md border px-2.5 py-1 text-xs font-medium transition-colors";
const RANGE = "accent-accent h-2 w-full cursor-pointer";
const CHECKBOX = "accent-accent size-4 cursor-pointer";
const HEADING = "text-text-muted text-xs font-medium tracking-wide uppercase";
---

<HtmlShell
  title="Lens | Alex Lin"
  description="An orbitable 3D model of a Sigma 18-50mm F2.8 lens."
>
  <Navbar />
  <!-- pt-16 clears the fixed navbar, which ?embed hides. -->
  <main class="w-full flex-1 pt-16 in-data-embedded:pt-0">
    <LensPreloads accessories />

    <!-- Mobile: canvas above, controls below. sm+: controls float over the canvas. -->
    <div
      class="relative flex h-[calc(100dvh-4rem)] w-full flex-col overflow-hidden in-data-embedded:h-dvh sm:block"
    >
      <div class="relative min-h-0 flex-1 sm:absolute sm:inset-0">
        <canvas id="scene" class="absolute inset-0 z-10 size-full touch-none"
        ></canvas>

        <!-- Shown instead of the canvas when the scene fails to start. -->
        <p
          id="scene-fallback"
          class="text-text-muted absolute inset-0 hidden items-center justify-center p-6 text-center text-sm"
        >
          This interactive viewer needs WebGPU or WebGL2, which this browser
          doesn't support.
        </p>
      </div>

      <div
        id="controls-panel"
        class="border-border bg-surface/90 z-20 flex max-h-[45dvh] shrink-0 flex-col border-t backdrop-blur sm:absolute sm:right-4 sm:bottom-4 sm:max-h-[calc(100dvh-6rem)] sm:w-80 sm:rounded-lg sm:border"
      >
        <div role="tablist" class="border-border flex border-b">
          {
            tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`tabpanel-${t.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                class="text-text-muted hover:text-text aria-selected:text-text aria-selected:border-accent flex-1 cursor-pointer border-b-2 border-transparent py-2.5 text-sm font-medium transition-colors"
              >
                {t.label}
              </button>
            ))
          }
        </div>

        <!-- Both tabpanels share one grid cell and the inactive one is only
             made invisible, so switching tabs never resizes the panel. -->
        <div class="grid min-h-0 overflow-y-auto">
          <div
            id="tabpanel-controls"
            role="tabpanel"
            aria-labelledby="tab-controls"
            class="col-start-1 row-start-1 flex flex-col gap-4 p-4"
          >
            <div id="slider-group" class="flex flex-col gap-4">
              {
                sliders.map((s) => (
                  <label class="flex flex-col gap-1.5">
                    <span class="text-text flex items-center justify-between text-sm font-medium">
                      {s.label}
                      <span class="text-text-muted text-xs font-normal">
                        {s.hint}
                      </span>
                    </span>
                    <input
                      type="range"
                      id={`slider-${s.id}`}
                      min="0"
                      max="100"
                      value="0"
                      class={RANGE}
                    />
                  </label>
                ))
              }
            </div>

            <div class="border-border flex flex-col gap-2 border-t pt-3">
              <span class={HEADING}>Shading</span>
              <div class="flex flex-wrap gap-1.5" id="shading-group">
                {
                  shadingModes.map((m) => (
                    <button
                      type="button"
                      data-shading={m.id}
                      aria-pressed={m.id === "ink" ? "true" : "false"}
                      class={PILL}
                    >
                      {m.label}
                    </button>
                  ))
                }
              </div>
              <label
                class="text-text-muted flex items-center justify-between gap-2 text-xs"
              >
                Transition
                <select
                  id="shading-transition"
                  class="border-border text-text cursor-pointer rounded-md border bg-transparent px-2 py-1 text-xs font-medium"
                >
                  {
                    shadingTransitions.map((t) => (
                      <option value={t.id} selected={t.id === "blink"}>
                        {t.label}
                      </option>
                    ))
                  }
                </select>
              </label>
            </div>

            <div class="border-border flex flex-col gap-2 border-t pt-3">
              <span class={HEADING}>Accessories</span>
              <div class="flex flex-wrap gap-x-4 gap-y-2">
                {
                  accessories.map((a) => (
                    <label class="text-text flex cursor-pointer items-center gap-2 text-sm">
                      <input
                        type="checkbox"
                        id={`acc-${a.id}`}
                        class={CHECKBOX}
                      />
                      {a.label}
                    </label>
                  ))
                }
              </div>
            </div>
          </div>

          <div
            id="tabpanel-animations"
            role="tabpanel"
            aria-labelledby="tab-animations"
            aria-hidden="true"
            class="pointer-events-none invisible col-start-1 row-start-1 flex flex-col gap-4 p-4"
          >
            <div class="flex flex-col gap-2">
              <div class="flex flex-wrap gap-1.5" id="animation-group">
                {
                  [{ id: "none", label: "None" }, ...ANIMATIONS].map((a) => (
                    <button
                      type="button"
                      data-animation={a.id}
                      aria-pressed={a.id === "none" ? "true" : "false"}
                      class={PILL}
                    >
                      {a.label}
                    </button>
                  ))
                }
              </div>
              <label
                id="animation-progress-row"
                class="pointer-events-none invisible flex flex-col gap-1.5"
              >
                <span
                  class="text-text flex items-center justify-between text-sm font-medium"
                >
                  Progress
                  <span
                    class="text-text-muted text-xs font-normal"
                    id="animation-hint"></span>
                </span>
                <input
                  type="range"
                  id="animation-progress"
                  min="0"
                  max="100"
                  value="0"
                  step="any"
                  class={RANGE}
                />
              </label>
              {
                tools.map((t) => (
                  <div
                    id={`${t.id}-row`}
                    class="border-border mt-1 flex flex-col gap-1 border-t pt-3"
                  >
                    <label class="text-text flex cursor-pointer items-center gap-2 text-sm font-medium">
                      <input
                        type="checkbox"
                        id={`${t.id}-toggle`}
                        class={CHECKBOX}
                      />
                      {t.label}
                    </label>
                    <span
                      id={`${t.id}-status`}
                      class="text-text-muted text-[0.6875rem] leading-snug"
                    >
                      {t.note}
                    </span>
                  </div>
                ))
              }
            </div>

            {
              /* Param sets share one grid cell too, so the tab height is stable. */
            }
            <div class="grid">
              {
                ANIMATIONS.filter((a) => a.params?.length).map((a) => (
                  <div
                    data-anim-params={a.id}
                    aria-hidden="true"
                    class="pointer-events-none invisible col-start-1 row-start-1 flex flex-col gap-4"
                  >
                    <button
                      type="button"
                      data-param-reset
                      class="text-text-muted hover:text-text self-end text-xs underline decoration-dotted underline-offset-2"
                    >
                      Reset to defaults
                    </button>
                    {a.params!.map((p) => (
                      <label class="flex flex-col gap-1.5">
                        <span class="text-text flex items-center justify-between text-sm font-medium">
                          <span class="flex items-baseline gap-2">
                            {p.label}
                            {/* live value, in the uniform's own units */}
                            <output
                              data-param-out={p.id}
                              class="text-accent font-mono text-xs tabular-nums"
                            >
                              {fmtParam(p.phys)}
                            </output>
                            {/* default value */}
                            <span class="text-text-muted/70 font-mono text-[10px] tabular-nums">
                              / {fmtParam(p.phys)}
                            </span>
                          </span>
                          <span class="text-text-muted text-xs font-normal">
                            {p.hint}
                          </span>
                        </span>
                        <input
                          type="range"
                          id={`anim-param-${a.id}-${p.id}`}
                          data-param={p.id}
                          min="0"
                          max="100"
                          value={String(p.value)}
                          class={RANGE}
                        />
                      </label>
                    ))}
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</HtmlShell>

<script>
  import {
    initScene,
    rangeOf,
    ANIM_RESET_CHANNELS,
    CHANNEL_DEFAULTS,
    loadAnimations,
    resetRecipeKnobs,
    type AccessoryGroup,
    type LensAnimation,
    type PathViz,
    type ShadingMode,
    type TransitionName,
    watchTheme,
  } from "../lib/lens";

  const byId = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;
  const all = <T extends HTMLElement>(selector: string) => [
    ...document.querySelectorAll<T>(selector),
  ];
  /** Show a status line, in the highlight colour when `ok` is false. */
  const setStatus = (el: HTMLElement | null, text: string, ok: boolean) => {
    if (!el) return;
    el.textContent = text;
    el.classList.toggle("text-highlight", !ok);
    el.classList.toggle("text-text-muted", ok);
  };
  /** Show or hide a grid-stacked element without changing its layout. */
  const setStacked = (el: HTMLElement, on: boolean) => {
    el.classList.toggle("invisible", !on);
    el.classList.toggle("pointer-events-none", !on);
    el.setAttribute("aria-hidden", String(!on));
  };

  async function boot() {
    const canvas = byId<HTMLCanvasElement>("scene");
    if (!canvas) return;
    let scene;
    try {
      // Pulled back a little so the lens clears the floating panel.
      scene = await initScene(canvas, { cameraDistance: 1.22 });
    } catch (err) {
      // Show the fallback message; blame the browser only if it lacks
      // WebGPU/WebGL2 (this also catches model load failures).
      console.warn("lens viewer: init failed, showing fallback message", err);
      canvas.remove();
      const fallback = byId("scene-fallback");
      if (fallback) {
        const supported =
          "gpu" in navigator ||
          Boolean(document.createElement("canvas").getContext("webgl2"));
        if (supported) {
          fallback.textContent =
            "The 3D lens model failed to load. Check your connection and reload the page.";
        }
        fallback.classList.replace("hidden", "flex");
      }
      byId("controls-panel")?.setAttribute("inert", "");
      return;
    }

    // Loaded lazily so the homepage bundle does not include the animations.
    const { ANIMATIONS, fmtParam } = await loadAnimations();
    const animById = (id: string | undefined) =>
      ANIMATIONS.find((a) => a.id === id);
    /** Update a param slider's readout from its uniform's current value. */
    const syncParamOut = (
      anim: LensAnimation | undefined,
      input: HTMLInputElement,
    ) => {
      const out = input
        .closest("label")
        ?.querySelector<HTMLOutputElement>("output[data-param-out]");
      const v = anim?.readParam?.(input.dataset.param ?? "");
      if (out && v !== undefined) out.textContent = fmtParam(v);
    };

    // Must match the frontmatter `sliders` ids.
    const sliderChannels = ["zoom", "focus", "aperture", "explode"] as const;
    const sliderInput = (id: string) => byId<HTMLInputElement>(`slider-${id}`);
    for (const id of sliderChannels) {
      const input = sliderInput(id);
      input?.addEventListener("input", () => {
        scene.state[`${id}Target`] = Number(input.value) / 100;
      });
    }

    for (const group of ["hood", "filter", "caps"] as AccessoryGroup[]) {
      const box = byId<HTMLInputElement>(`acc-${group}`);
      box?.addEventListener("change", () =>
        scene.setAccessory(group, box.checked),
      );
    }

    watchTheme((light) => scene.setTheme(light));

    // Load the extra shading modes up front so each swap below is synchronous.
    const benchOk = await scene.enableShadingBench();
    const shadingButtons = all<HTMLButtonElement>(
      "#shading-group button[data-shading]",
    );
    const transitionSelect = byId<HTMLSelectElement>("shading-transition");
    for (const btn of shadingButtons) {
      // If the extra modes failed to load, only realistic and ink work.
      if (
        !benchOk &&
        btn.dataset.shading !== "realistic" &&
        btn.dataset.shading !== "ink"
      ) {
        btn.disabled = true;
        continue;
      }
      btn.addEventListener("click", () => {
        scene.swapShading(btn.dataset.shading as ShadingMode, {
          transition: (transitionSelect?.value ?? "blink") as TransitionName,
        });
        for (const other of shadingButtons) {
          other.setAttribute("aria-pressed", String(other === btn));
        }
      });
    }
    scene.setShading("ink"); // must match the pressed button in the markup

    // --- Tabs ---
    const tabs = all<HTMLButtonElement>('[role="tablist"] [role="tab"]');
    const selectTab = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        const panel = byId(t.getAttribute("aria-controls") ?? "");
        if (panel) setStacked(panel, on);
      }
    };
    for (const t of tabs)
      t.addEventListener("click", () => {
        selectTab(t);
        localStorage.setItem("lens-tab", t.id);
      });

    // --- Animations ---
    // An animation drives the channels from the progress slider and disables
    // the manual sliders; None hands control back to them.
    const sliderGroup = byId("slider-group");
    const animButtons = all<HTMLButtonElement>(
      "#animation-group button[data-animation]",
    );
    const progressRow = byId("animation-progress-row");
    const progressInput = byId<HTMLInputElement>("animation-progress");
    const progressOf = () => Number(progressInput?.value ?? 0) / 100;
    const animHint = byId("animation-hint");
    // One param-slider set per animation that has params.
    const paramContainers = all<HTMLElement>("[data-anim-params]");
    let activeAnim: LensAnimation | null = null;

    // --- Motion paths ---
    const pathsToggle = byId<HTMLInputElement>("paths-toggle");
    const pathsStatus = byId("paths-status");
    let pathViz: PathViz | null = null;
    let pathsDebounce = 0;
    const refreshPaths = async () => {
      if (!pathViz || !pathsToggle?.checked) return;
      await pathViz.show(activeAnim, progressOf);
    };
    // Re-walk the motion path once a param drag settles.
    const refreshPathsSoon = () => {
      window.clearTimeout(pathsDebounce);
      pathsDebounce = window.setTimeout(() => void refreshPaths(), 250);
    };
    const applyPathsToggle = async () => {
      if (pathsToggle?.checked) {
        pathViz ??= await scene.enablePathViz((text, ok) =>
          setStatus(pathsStatus, text, ok),
        );
        pathViz?.setVisible(true);
        await refreshPaths();
      } else {
        pathViz?.setVisible(false);
        window.clearTimeout(pathsDebounce);
      }
    };
    pathsToggle?.addEventListener("change", () => void applyPathsToggle());

    // --- Inspect ---
    const inspectToggle = byId<HTMLInputElement>("inspect-toggle");
    const inspectStatus = byId("inspect-status");
    const inspectHint = inspectStatus?.textContent?.trim() ?? "";
    const applyInspectToggle = async () => {
      if (!inspectToggle) return;
      const ok = await scene.enableInspect(inspectToggle.checked);
      setStatus(
        inspectStatus,
        ok ? inspectHint : "inspector failed to start — see console",
        ok,
      );
    };
    inspectToggle?.addEventListener("change", () => void applyInspectToggle());

    // Under an animation the slider channels take their markup defaults and
    // the sliders lock, except zoom/focus/aperture when it is `manualMech`.
    const syncSliders = (anim: LensAnimation | null) => {
      const mechFree = Boolean(anim?.manualMech);
      const locked = Boolean(anim) && !mechFree;
      sliderGroup?.classList.toggle("pointer-events-none", locked);
      sliderGroup?.classList.toggle("opacity-50", locked);
      for (const id of sliderChannels) {
        const input = sliderInput(id);
        if (!input) continue;
        const off = Boolean(anim) && !(mechFree && id !== "explode");
        scene.state[`${id}Target`] =
          Number(off ? input.defaultValue : input.value) / 100;
        input.disabled = off;
        input.closest("label")?.classList.toggle("opacity-50", off && mechFree);
      }
    };

    // --- Hero camera ---
    // Animation progress maps onto the story from "rewrap" through "capsOn".
    const STORY_CAM_SPAN: readonly [number, number] = [
      rangeOf("rewrap").p0,
      rangeOf("capsOn").p1,
    ];
    const storyPOf = (p: number) =>
      STORY_CAM_SPAN[0] + (STORY_CAM_SPAN[1] - STORY_CAM_SPAN[0]) * p;
    const storyCamToggle = byId<HTMLInputElement>("storycam-toggle");
    const storyCamActive = () => Boolean(storyCamToggle?.checked && activeAnim);
    // Engaging snaps the story channel so the camera doesn't sweep the story.
    const syncStoryCam = () => {
      const on = storyCamActive();
      scene.setStoryCamera(on);
      if (on)
        scene.state.story = scene.state.storyTarget = storyPOf(progressOf());
    };
    storyCamToggle?.addEventListener("change", () => {
      localStorage.setItem("lens-herocam", storyCamToggle.checked ? "1" : "0");
      syncStoryCam();
    });

    // The shown progress eases toward the slider and lands exactly on it, so
    // every frame is a real pose of the animation. Reduced motion jumps.
    const EASE = 0.15;
    let shownP = 0;
    let targetP = 0;
    let glideRaf = 0;
    let glideLast = 0;
    const applyAt = (p: number) => {
      if (!activeAnim) return;
      activeAnim.apply(p, scene.state);
      scene.invalidate();
    };
    const snapTo = (p: number) => {
      cancelAnimationFrame(glideRaf);
      glideRaf = 0;
      shownP = targetP = p;
      applyAt(p);
    };
    const glideStep = (now: number) => {
      glideRaf = 0;
      const gap = targetP - shownP;
      if (Math.abs(gap) < 5e-4) return snapTo(targetP);
      const a = 1 - Math.pow(1 - EASE, (now - glideLast) / 16.7);
      glideLast = now;
      shownP += gap * Math.min(1, a);
      applyAt(shownP);
      glideRaf = requestAnimationFrame(glideStep);
    };
    const glideTo = (p: number) => {
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
        return snapTo(p);
      targetP = p;
      if (!glideRaf) {
        glideLast = performance.now();
        glideRaf = requestAnimationFrame(glideStep);
      }
    };

    const selectAnimation = (anim: LensAnimation | null) => {
      activeAnim?.exit?.();
      // Must sit between exit() and enter() so enter()'s presets survive.
      resetRecipeKnobs();
      activeAnim = anim;
      anim?.enter?.();
      localStorage.setItem("lens-anim", anim?.id ?? "none");
      for (const btn of animButtons) {
        btn.setAttribute(
          "aria-pressed",
          String(btn.dataset.animation === (anim?.id ?? "none")),
        );
      }
      // Reset every channel an animation may drive (slider channels excepted).
      for (const c of ANIM_RESET_CHANNELS)
        scene.state[`${c}Target`] = CHANNEL_DEFAULTS[c];
      syncSliders(anim);
      snapTo(progressOf());
      scene.invalidate();
      if (progressRow) setStacked(progressRow, Boolean(anim));
      if (animHint) animHint.textContent = anim?.hint ?? "";
      for (const c of paramContainers) {
        setStacked(c, c.dataset.animParams === anim?.id);
        // Knobs were just reset, so thumbs return to their markup defaults.
        const ca = animById(c.dataset.animParams);
        for (const input of c.querySelectorAll<HTMLInputElement>(
          "input[data-param]",
        )) {
          input.value = input.defaultValue;
          syncParamOut(ca, input);
        }
      }
      syncStoryCam();
      void refreshPaths();
    };

    for (const btn of animButtons) {
      btn.addEventListener("click", () =>
        selectAnimation(animById(btn.dataset.animation) ?? null),
      );
    }

    // Restore the last tab, animation, progress and hero-camera choice.
    const tab = tabs.find(
      (t) => t.id === (localStorage.getItem("lens-tab") ?? "tab-animations"),
    );
    if (tab) selectTab(tab);
    const storedP = localStorage.getItem("lens-progress");
    if (storedP && progressInput) progressInput.value = storedP;
    const storedAnim = animById(localStorage.getItem("lens-anim") ?? undefined);
    if (storedAnim) selectAnimation(storedAnim);
    if (localStorage.getItem("lens-herocam") === "1" && storyCamToggle) {
      storyCamToggle.checked = true;
      syncStoryCam();
    }
    // Browsers restore checkbox state on reload without a `change` event.
    // After the animation restore, since the path walk uses it.
    void applyPathsToggle();
    void applyInspectToggle();

    progressInput?.addEventListener("input", () => {
      if (activeAnim) glideTo(progressOf());
      scene.invalidate();
      localStorage.setItem("lens-progress", progressInput.value);
      // Target only, so the camera eases after the scrub.
      if (storyCamActive()) scene.state.storyTarget = storyPOf(progressOf());
    });

    // Param sliders write their shader uniforms directly.
    for (const c of paramContainers) {
      const anim = animById(c.dataset.animParams);
      const inputs = [
        ...c.querySelectorAll<HTMLInputElement>("input[data-param]"),
      ];
      const setParam = (input: HTMLInputElement, value: string) => {
        anim?.setParam?.(input.dataset.param ?? "", Number(value) / 100);
        syncParamOut(anim, input);
      };
      c.querySelector("button[data-param-reset]")?.addEventListener(
        "click",
        () => {
          for (const input of inputs) {
            input.value = input.defaultValue;
            setParam(input, input.defaultValue);
          }
          scene.invalidate();
          refreshPathsSoon();
        },
      );
      for (const input of inputs) {
        input.addEventListener("input", () => {
          setParam(input, input.value);
          scene.invalidate();
          refreshPathsSoon();
        });
      }
    }
  }
  boot();
</script>
