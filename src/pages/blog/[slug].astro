---
import { Icon } from "astro-icon/components";
import { getCollection, getEntry, render } from "astro:content";
import Prose from "../../components/Prose.astro";
import ProseLayout from "../../layouts/ProseLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Resolve the post's referenced project/demo entries (reference() validates
// they exist at build, but getEntry is typed as possibly undefined).
const linkedProjects = (
  await Promise.all(post.data.projects.map((ref) => getEntry(ref)))
).filter((entry): entry is NonNullable<typeof entry> => entry != null);

const dateFormatter = new Intl.DateTimeFormat(undefined, {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<ProseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
>
  <a
    href="/blog"
    class="text-text-muted hover:text-text inline-flex items-center gap-2 text-sm font-medium"
  >
    <Icon name="lucide:arrow-left" class="size-4" />
    Blog
  </a>
  <p class="text-accent mt-10 text-sm font-semibold tracking-wide uppercase">
    Blog
  </p>
  <h1 class="text-text mt-3 text-4xl leading-tight font-black">
    {post.data.title}
  </h1>
  <div
    class="text-text-muted mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm"
  >
    <time datetime={post.data.date.toISOString()}
      >{dateFormatter.format(post.data.date)}</time
    >
    {
      post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="bg-accent-soft text-accent rounded px-2 py-0.5 text-xs font-medium">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <Prose class="mt-8">
    <Content />
  </Prose>

  {
    linkedProjects.length > 0 && (
      <div class="border-border mt-12 border-t pt-8">
        <h2 class="text-text text-sm font-semibold tracking-wide uppercase">
          Interactive demos
        </h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {linkedProjects.map((project) => (
            <a
              href={`/projects/${project.id}`}
              class="border-border bg-surface hover:border-accent group flex items-start gap-4 rounded-md border p-4 transition-colors"
            >
              <span class="bg-accent-soft text-accent flex size-10 shrink-0 items-center justify-center rounded-md">
                <Icon name={project.data.icon} class="size-5" />
              </span>
              <span class="min-w-0">
                <span class="text-text group-hover:text-accent block font-semibold transition-colors">
                  {project.data.title}
                </span>
                <span class="text-text-muted mt-1 block text-sm leading-6">
                  {project.data.summary}
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    )
  }
</ProseLayout>
