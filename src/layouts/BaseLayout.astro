---
import Navbar from "../components/Navbar.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  fullWidth?: boolean;
  hideChrome?: boolean;
}

const {
  title = "Personal Website",
  description = "Personal website",
  lang = "en",
  fullWidth = false,
  hideChrome = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <!-- Blocking, un-bundled script: set the theme class before first paint to
         avoid a flash of the wrong theme (FOUC). The .dark class also drives
         which toggle icon is visible via CSS, so the right icon paints
         immediately — no dependency on Alpine booting. -->
    <script is:inline>
      const media = window.matchMedia("(prefers-color-scheme: dark)");
      const apply = (dark) =>
        document.documentElement.classList.toggle("dark", dark);

      // Initial theme: an explicit user choice wins, else follow the OS.
      const stored = localStorage.getItem("theme");
      apply(stored ? stored === "dark" : media.matches);

      // An OS theme change always wins: apply it and drop any manual override
      // so a reload stays consistent with what's shown.
      media.addEventListener("change", (e) => {
        localStorage.removeItem("theme");
        apply(e.matches);
      });
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700;800;900&family=Inter:opsz,wght@14..32,400..900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    {!hideChrome && <Navbar />}

    <main
      class:list={[
        "w-full flex-1",
        fullWidth || hideChrome
          ? ""
          : "max-w-layout mx-auto px-4 sm:px-6 lg:px-8",
      ]}
    >
      <slot />
    </main>

    {
      !hideChrome && (
        <footer class="border-border border-t">
          <div class="max-w-layout text-text-muted mx-auto flex h-16 items-center px-4 text-sm sm:px-6 lg:px-8">
            <p>&copy; {new Date().getFullYear()} Personal Website</p>
          </div>
        </footer>
      )
    }
  </body>
</html>
