---
/**
 * The standard page: navbar, a max-width container padded clear of the fixed
 * nav, footer.
 */
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import HtmlShell from "./HtmlShell.astro";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const { title, description, lang } = Astro.props;
---

<HtmlShell title={title} description={description} lang={lang}>
  <Navbar />
  <main class="max-w-layout mx-auto w-full flex-1 px-4 pt-16 sm:px-6 lg:px-8">
    <slot />
  </main>
  <Footer />
</HtmlShell>
