---
/**
 * Document shell: <head> (meta, fonts, title) + the pre-paint theme bootstrap
 * and iframe-embed detection, wrapping a bare <body>.
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = "Alex Lin",
  description = "Personal website",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />

    <!-- Blocking, un-bundled: MUST run before first paint — the initial theme
         class (no FOUC) and the ?embed chrome flag. Everything else (OS-change
         listener, toggle) lives bundled in src/lib/alpine.ts. -->
    <script is:inline>
      const t = localStorage.getItem("theme");
      document.documentElement.classList.toggle(
        "dark",
        t ? t === "dark" : matchMedia("(prefers-color-scheme: dark)").matches,
      );
      if (new URLSearchParams(location.search).has("embed"))
        document.documentElement.dataset.embedded = "true";
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bitter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500&family=Inter:opsz,wght@14..32,400..900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-dvh flex-col">
    <slot />
  </body>
</html>
